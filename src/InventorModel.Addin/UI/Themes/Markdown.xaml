<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="MarkdownTextBrush" Color="#202124" />
  <SolidColorBrush x:Key="MarkdownSecondaryBrush" Color="#5F6368" />
  <SolidColorBrush x:Key="MarkdownBorderBrush" Color="#DADCE0" />
  <SolidColorBrush x:Key="MarkdownCodeBrush" Color="#F5F6F8" />
  <SolidColorBrush x:Key="MarkdownAccentBrush" Color="#1967D2" />

  <Style x:Key="MarkdownParagraphStyleBase" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource MarkdownTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style x:Key="MarkdownParagraphStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MarkdownParagraphStyleBase}">
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style x:Key="MarkdownHeading1StyleBase" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="Foreground" Value="{StaticResource MarkdownTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,4,0,7" />
  </Style>
  <Style x:Key="MarkdownHeading1Style" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MarkdownHeading1StyleBase}">
    <Setter Property="FontSize" Value="18" />
  </Style>
  <Style x:Key="MarkdownHeading2StyleBase" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MarkdownHeading1StyleBase}">
    <Setter Property="FontSize" Value="16" />
  </Style>
  <Style x:Key="MarkdownHeading2Style" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MarkdownHeading2StyleBase}" />
  <Style x:Key="MarkdownHeading3StyleBase" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MarkdownHeading1StyleBase}">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style x:Key="MarkdownHeading3Style" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MarkdownHeading3StyleBase}" />
  <Style x:Key="MarkdownHeading4StyleBase" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MarkdownHeading1StyleBase}">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="MarkdownHeading4Style" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MarkdownHeading4StyleBase}" />
  <Style x:Key="MarkdownHeading5StyleBase" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MarkdownHeading1StyleBase}">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style x:Key="MarkdownHeading5Style" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MarkdownHeading5StyleBase}" />
  <Style x:Key="MarkdownHeading6StyleBase" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MarkdownHeading1StyleBase}">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource MarkdownSecondaryBrush}" />
  </Style>
  <Style x:Key="MarkdownHeading6Style" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MarkdownHeading6StyleBase}" />

  <Style x:Key="MarkdownCodeBlockBorderStyleBase" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{StaticResource MarkdownCodeBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MarkdownBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,2,0,8" />
  </Style>
  <Style x:Key="MarkdownCodeBlockBorderStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource MarkdownCodeBlockBorderStyleBase}" />

  <Style x:Key="MarkdownCodeBlockStyleBase" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="Consolas" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource MarkdownTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="18" />
  </Style>
  <Style x:Key="MarkdownCodeBlockStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MarkdownCodeBlockStyleBase}" />

  <Style x:Key="MarkdownThematicBreakStyleBase" TargetType="{x:Type Border}">
    <Setter Property="BorderBrush" Value="{StaticResource MarkdownBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Margin" Value="0,4,0,8" />
  </Style>
  <Style x:Key="MarkdownThematicBreakStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource MarkdownThematicBreakStyleBase}" />

  <Style x:Key="MarkdownListStyleBase" TargetType="{x:Type StackPanel}">
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style x:Key="MarkdownListStyle" TargetType="{x:Type StackPanel}" BasedOn="{StaticResource MarkdownListStyleBase}" />

  <Style x:Key="MarkdownListItemStyleBase" TargetType="{x:Type Grid}">
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>
  <Style x:Key="MarkdownListItemStyle" TargetType="{x:Type Grid}" BasedOn="{StaticResource MarkdownListItemStyleBase}" />

  <Style x:Key="MarkdownListItemMarkerStyleBase" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource MarkdownSecondaryBrush}" />
    <Setter Property="Margin" Value="6,0,7,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style x:Key="MarkdownListItemMarkerStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MarkdownListItemMarkerStyleBase}" />

  <Style x:Key="MarkdownTableStyleBase" TargetType="{x:Type Grid}">
    <Setter Property="Margin" Value="0,4,0,8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="MarkdownTableStyle" TargetType="{x:Type Grid}" BasedOn="{StaticResource MarkdownTableStyleBase}" />

  <Style x:Key="MarkdownTableCellStyleBase" TargetType="{x:Type Border}">
    <Setter Property="BorderBrush" Value="{StaticResource MarkdownBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="TextBlock.Foreground" Value="{StaticResource MarkdownTextBrush}" />
  </Style>
  <Style x:Key="MarkdownTableCellStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource MarkdownTableCellStyleBase}" />

  <Style x:Key="MarkdownTableHeaderCellStyleBase" TargetType="{x:Type Border}" BasedOn="{StaticResource MarkdownTableCellStyleBase}">
    <Setter Property="Background" Value="#EEF3FA" />
    <Setter Property="TextBlock.FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="MarkdownTableHeaderCellStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource MarkdownTableHeaderCellStyleBase}" />

  <Style x:Key="MarkdownBlockquoteStyleBase" TargetType="{x:Type Border}">
    <Setter Property="BorderBrush" Value="{StaticResource MarkdownAccentBrush}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="Padding" Value="10,2,0,2" />
    <Setter Property="Margin" Value="0,2,0,8" />
    <Setter Property="TextBlock.Foreground" Value="{StaticResource MarkdownSecondaryBrush}" />
  </Style>
  <Style x:Key="MarkdownBlockQuoteStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource MarkdownBlockquoteStyleBase}" />

  <Style x:Key="MarkdownCodeInlineStyle" TargetType="{x:Type Run}">
    <Setter Property="FontFamily" Value="Consolas" />
    <Setter Property="Background" Value="{StaticResource MarkdownCodeBrush}" />
    <Setter Property="Foreground" Value="{StaticResource MarkdownTextBrush}" />
  </Style>
  <Style x:Key="MarkdownLinkStyle" TargetType="{x:Type Hyperlink}">
    <Setter Property="Foreground" Value="{StaticResource MarkdownAccentBrush}" />
    <Setter Property="TextDecorations" Value="None" />
  </Style>
  <Style x:Key="MarkdownStrongStyle" TargetType="{x:Type Span}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="MarkdownEmphasisStyle" TargetType="{x:Type Span}">
    <Setter Property="FontStyle" Value="Italic" />
  </Style>
  <Style x:Key="MarkdownStrikethroughStyle" TargetType="{x:Type Span}">
    <Setter Property="TextDecorations" Value="Strikethrough" />
  </Style>
  <Style x:Key="MarkdownMarkStyle" TargetType="{x:Type Span}">
    <Setter Property="Background" Value="#FFF1A8" />
  </Style>
  <Style x:Key="MarkdownSubscriptStyle" TargetType="{x:Type Span}">
    <Setter Property="BaselineAlignment" Value="Subscript" />
    <Setter Property="FontSize" Value="9" />
  </Style>
  <Style x:Key="MarkdownSuperscriptStyle" TargetType="{x:Type Span}">
    <Setter Property="BaselineAlignment" Value="Superscript" />
    <Setter Property="FontSize" Value="9" />
  </Style>
</ResourceDictionary>
