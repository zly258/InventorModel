<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <FontFamily x:Key="AppFontFamily">Microsoft YaHei</FontFamily>
  <FontFamily x:Key="Font.Ui">Microsoft YaHei</FontFamily>
  <FontFamily x:Key="Font.Mono">Microsoft YaHei</FontFamily>

  <sys:Double x:Key="Layout.ControlHeight">34</sys:Double>
  <sys:Double x:Key="Layout.ControlHeight.Small">30</sys:Double>
  <CornerRadius x:Key="Radius.Small">6</CornerRadius>
  <CornerRadius x:Key="Radius.Card">8</CornerRadius>
  <CornerRadius x:Key="Radius.Input">7</CornerRadius>

  <SolidColorBrush x:Key="AppCanvasBrush" Color="#F6F7FB" />
  <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AppSurfaceMutedBrush" Color="#F2F4F7" />
  <SolidColorBrush x:Key="AppTextBrush" Color="#1F2328" />
  <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#667085" />
  <SolidColorBrush x:Key="AppMutedTextBrush" Color="#667085" />
  <SolidColorBrush x:Key="AppDisabledTextBrush" Color="#A5ACBA" />
  <SolidColorBrush x:Key="AppBorderBrush" Color="#D9DEE8" />
  <SolidColorBrush x:Key="AppBorderStrongBrush" Color="#C3CBDA" />
  <SolidColorBrush x:Key="AppBrandBrush" Color="#2563EB" />
  <SolidColorBrush x:Key="AppBrandHoverBrush" Color="#1D4ED8" />
  <SolidColorBrush x:Key="AppBrandPressedBrush" Color="#1B4BC4" />
  <SolidColorBrush x:Key="AppOnBrandTextBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AppControlHoverBrush" Color="#F3F5F9" />
  <SolidColorBrush x:Key="AppControlPressedBrush" Color="#E9EDF4" />
  <SolidColorBrush x:Key="AppSelectionBrush" Color="#EEF4FF" />
  <SolidColorBrush x:Key="AppDangerBrush" Color="#D92D20" />
  <SolidColorBrush x:Key="AppDangerSoftBrush" Color="#FFF1F0" />

  <Style TargetType="Window">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{StaticResource AppCanvasBrush}" />
    <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
  </Style>

  <ControlTemplate x:Key="AppButtonTemplate" TargetType="{x:Type Button}">
    <Border x:Name="Border"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{StaticResource Radius.Small}">
      <ContentPresenter Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
    </Border>
  </ControlTemplate>

  <Style TargetType="Button">
    <Setter Property="Height" Value="{StaticResource Layout.ControlHeight}" />
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
    <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template" Value="{StaticResource AppButtonTemplate}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource AppControlHoverBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderStrongBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource AppControlPressedBrush}" />
      </Trigger>
      <Trigger Property="Tag" Value="Primary">
        <Setter Property="Background" Value="{StaticResource AppBrandBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBrandBrush}" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="Tag" Value="Primary" />
          <Condition Property="IsMouseOver" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{StaticResource AppBrandHoverBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBrandHoverBrush}" />
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="Tag" Value="Primary" />
          <Condition Property="IsPressed" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{StaticResource AppBrandPressedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBrandPressedBrush}" />
      </MultiTrigger>
      <Trigger Property="Tag" Value="Danger">
        <Setter Property="Foreground" Value="{StaticResource AppDangerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppDangerBrush}" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="Tag" Value="Danger" />
          <Condition Property="IsMouseOver" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{StaticResource AppDangerSoftBrush}" />
      </MultiTrigger>
      <Trigger Property="Tag" Value="Icon">
        <Setter Property="Width" Value="30" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="Tag" Value="Icon" />
          <Condition Property="IsMouseOver" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{StaticResource AppControlHoverBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </MultiTrigger>
      <Trigger Property="Tag" Value="PrimaryIcon">
        <Setter Property="Background" Value="{StaticResource AppBrandBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBrandBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="Tag" Value="PrimaryIcon" />
          <Condition Property="IsMouseOver" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{StaticResource AppBrandHoverBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBrandHoverBrush}" />
      </MultiTrigger>
      <Trigger Property="Tag" Value="DangerIcon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AppDangerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppDangerBrush}" />
        <Setter Property="Padding" Value="0" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="Tag" Value="DangerIcon" />
          <Condition Property="IsMouseOver" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{StaticResource AppDangerSoftBrush}" />
      </MultiTrigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{StaticResource AppSurfaceMutedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AppDisabledTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <ControlTemplate x:Key="AppTextBoxTemplate" TargetType="{x:Type TextBox}">
    <Border x:Name="Border"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{StaticResource Radius.Input}">
      <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AppBrandBrush}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="TextBox">
    <Setter Property="MinHeight" Value="{StaticResource Layout.ControlHeight}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
    <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template" Value="{StaticResource AppTextBoxTemplate}" />
  </Style>

  <Style TargetType="PasswordBox">
    <Setter Property="Height" Value="{StaticResource Layout.ControlHeight}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
    <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Height" Value="{StaticResource Layout.ControlHeight}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
    <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource AppControlHoverBrush}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource AppSelectionBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
  </Style>

  <Style TargetType="ListView">
    <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style TargetType="ListViewItem">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource AppSelectionBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
