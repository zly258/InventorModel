<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="AppFontFamily">Microsoft YaHei UI, Microsoft YaHei, Segoe UI</FontFamily>

    <SolidColorBrush x:Key="AppCanvasBrush" Color="#E9EDF2" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FAFBFC" />
    <SolidColorBrush x:Key="AppSurfaceMutedBrush" Color="#F2F4F7" />
    <SolidColorBrush x:Key="AppTextBrush" Color="#1F2933" />
    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#4B5563" />
    <SolidColorBrush x:Key="AppMutedTextBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="AppDisabledTextBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#D0D5DB" />
    <SolidColorBrush x:Key="AppBorderStrongBrush" Color="#AEB7C2" />
    <SolidColorBrush x:Key="AppBrandBrush" Color="#2F6F9F" />
    <SolidColorBrush x:Key="AppBrandHoverBrush" Color="#285F88" />
    <SolidColorBrush x:Key="AppBrandPressedBrush" Color="#204D70" />
    <SolidColorBrush x:Key="AppOnBrandTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppControlHoverBrush" Color="#F0F3F6" />
    <SolidColorBrush x:Key="AppSelectionBrush" Color="#E4EEF5" />
    <SolidColorBrush x:Key="AppDangerBrush" Color="#A94442" />

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{StaticResource AppCanvasBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="76" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AppControlHoverBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Primary">
                <Setter Property="Background" Value="{StaticResource AppBrandBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AppOnBrandTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppBrandBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Danger">
                <Setter Property="Foreground" Value="{StaticResource AppDangerBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Height" Value="28" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AppSelectionBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>