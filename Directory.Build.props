<Project>
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <Version>0.2.1</Version>
    <Authors>zly258</Authors>
    <Company>zly258</Company>
    <Product>InventorModel</Product>
    <Description>AI-oriented parametric Part modeling for Autodesk Inventor through MCP and a compact DSL.</Description>
    <Copyright>Copyright © 2026 zly258</Copyright>
    <RepositoryUrl>https://github.com/zly258/InventorModel</RepositoryUrl>
    <PackageProjectUrl>https://github.com/zly258/InventorModel</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>

    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <BaseOutputPath>$(RepositoryRoot)bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(RepositoryRoot)obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <InventorInstallRoot Condition="'$(InventorInstallRoot)' == ''">C:\Program Files\Autodesk\Inventor 2023</InventorInstallRoot>
    <InventorInteropPath Condition="'$(InventorInteropPath)' == ''">$(InventorInstallRoot)\Bin\Public Assemblies\Autodesk.Inventor.Interop.dll</InventorInteropPath>
  </PropertyGroup>
</Project>
